#@ case control/for_in_runtime_array
#@ spec 05-statements.md#for
#@ exit 0
#@ stdout
#@ | 2
#@ | 4
#@ | 6

module for_in_runtime_array

func build(n: int) -> array[int] {
    var xs: array[int] = []
    for i in range(1, n + 1) {
        append(xs, i * 2)
    }
    return xs
}

func main() {
    for v in build(3) {
        print(v)
    }
}
