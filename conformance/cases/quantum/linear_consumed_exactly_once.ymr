module linear_consumed_exactly_once

func pass(q: qubit) -> qubit {
    return q
}

func main() {
    q := qubit()
    q2 := pass(q)
    discard(q2)

    r := qreg[2]()
    bits := measure_all(r)
    print("done")
}
