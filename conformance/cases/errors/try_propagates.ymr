#@ case errors/try_propagates
#@ spec 06-errors.md#propagation-the-try-expression
#@ exit 0
#@ stdout
#@ | caught: missing /nope

module try_propagates

enum IOError    { NotFound(string), }
enum ParseError { UnexpectedEOF, }

func readFile(path: string) -> (string, IOError) {
    return "", IOError.NotFound(path)
}

func parse(data: string) -> (int, ParseError) {
    return 7, nil
}

func load(path: string) -> (int, IOError | ParseError) {
    data := try readFile(path)
    n := try parse(data)
    return n, nil
}

func main() {
    _, err := load("/nope")
    if err != nil {
        match err {
            IOError.NotFound(p)      => print("caught: missing " + p),
            ParseError.UnexpectedEOF => print("caught: truncated"),
        }
    }
}
