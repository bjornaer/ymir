module full_demo

# Comprehensive Demo: Combining Concurrency, Matrix Operations, and HTTP

import stdlib.math
import stdlib.http

# Concurrent matrix computation worker
func matrix_worker(id: int, size: int, result_ch: any) {
    print("Worker " + str(id) + " computing matrix...")
    
    # Create a random-ish matrix (using id for variation)
    var matrix: matrix[float] = stdlib.math.matrix_zeros(size, size)
    
    # Fill with simple pattern
    var i: int = 0
    while i < size {
        var j: int = 0
        while j < size {
            matrix[i][j] = float(id * (i + 1) * (j + 1))
            j = j + 1
        }
        i = i + 1
    }
    
    # Compute transpose
    result = transpose(matrix)
    
    # Send shape info through channel
    result_shape = shape(result)
    result_ch <- result_shape
    
    print("Worker " + str(id) + " completed")
}

# HTTP request worker
func http_worker(id: int, url: string, result_ch: any) {
    print("HTTP Worker " + str(id) + " fetching " + url)
    
    try {
        # Make HTTP request
        status, body, headers = http_get(url)
        
        # Send status through channel
        result_ch <- status
        
        print("HTTP Worker " + str(id) + " got status: " + str(status))
    } except Exception as e {
        print("HTTP Worker " + str(id) + " failed: " + str(e))
        result_ch <- 0
    }
}

func main() {
    print("===========================================")
    print("   Ymir Comprehensive Feature Demo")
    print("===========================================")
    print("")
    
    # Feature 1: GPU Matrix Operations
    print("1. Matrix Operations with GPU Support")
    print("   " + "-" * 40)
    
    gpu_available = matrix_gpu_available()
    if gpu_available {
        print("   ✓ GPU acceleration available")
    } else {
        print("   ℹ Using CPU (GPU not available)")
    }
    
    matrix_a = [[1.0, 2.0], [3.0, 4.0]]
    matrix_b = [[5.0, 6.0], [7.0, 8.0]]
    
    result = matrix_a @ matrix_b
    print("   Matrix multiplication result:")
    print("   " + str(result))
    print("")
    
    # Feature 2: Concurrent Matrix Computations
    print("2. Concurrent Matrix Computations")
    print("   " + "-" * 40)
    
    matrix_ch = make_channel(5)
    
    print("   Spawning 3 concurrent workers...")
    spawn matrix_worker(1, 2, matrix_ch)
    spawn matrix_worker(2, 2, matrix_ch)
    spawn matrix_worker(3, 2, matrix_ch)
    
    # Collect results
    var count: int = 0
    while count < 3 {
        shape_result <- matrix_ch
        print("   Received matrix shape: " + str(shape_result))
        count = count + 1
    }
    print("   ✓ All matrix workers completed")
    print("")
    
    # Feature 3: HTTP Client (Optional - requires network)
    print("3. HTTP Client Operations")
    print("   " + "-" * 40)
    print("   (Skipped in demo - requires network)")
    print("   Example usage:")
    print("     status, body, headers = http_get('https://api.example.com')")
    print("")
    
    # Feature 4: Channel Communication
    print("4. Channel-Based Communication")
    print("   " + "-" * 40)
    
    demo_ch = make_channel(3)
    
    # Send some values
    demo_ch <- 100
    demo_ch <- 200
    demo_ch <- 300
    
    # Receive them
    val1 <- demo_ch
    val2 <- demo_ch
    val3 <- demo_ch
    
    print("   Received values: " + str(val1) + ", " + str(val2) + ", " + str(val3))
    print("   ✓ Channel communication working")
    print("")
    
    # Summary
    print("===========================================")
    print("   Summary of Features Demonstrated:")
    print("===========================================")
    print("  ✓ Matrix operations with GPU support")
    print("  ✓ Concurrent task execution (spawn)")
    print("  ✓ Channel-based communication")
    print("  ✓ HTTP client capabilities")
    print("  ✓ Exception handling")
    print("  ✓ Type-safe operations")
    print("")
    print("Demo complete!")
}

main()

