module simple_example

# Simple function definition
func add(a: int, b: int) -> int {
    return a + b
}

# Simple conditional
func check_positive(n: int) -> string {
    if (n > 0) {
        return "Positive"
    } else {
        return "Non-positive"
    }
}

# Simple loop
func countdown(start: int) {
    while (start > 0) {
        print(str(start))
        start = start - 1
    }
    print("Liftoff!")
}

# Main function
func main() {
    print("Hello, Ymir!")

    # Function call
    result = add(10, 20)
    print("10 + 20 = " + str(result))

    # Conditional
    result = check_positive(-5)
    print("Check positive: " + result)

    # Loop
    countdown(3)
}

main()
