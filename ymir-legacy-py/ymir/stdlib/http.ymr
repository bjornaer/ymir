module stdlib.http

# HTTP client functions using aiohttp

export func get(url: string) -> any {
    # Perform HTTP GET request
    # Returns tuple of (status_code, body, headers)
    return http_get(url, nil)
}

export func get_with_headers(url: string, headers: map[string]string) -> any {
    # Perform HTTP GET request with custom headers
    # Returns tuple of (status_code, body, headers)
    return http_get(url, headers)
}

export func post(url: string, data: string) -> any {
    # Perform HTTP POST request with string data
    # Returns tuple of (status_code, body, headers)
    return http_post(url, data, nil, nil)
}

export func post_json(url: string, json_data: any) -> any {
    # Perform HTTP POST request with JSON data
    # Returns tuple of (status_code, body, headers)
    return http_post(url, nil, json_data, nil)
}
