                if (row[j] > max_val) {
                    max_val = row[j]
                    max_row = i
                    max_col = j
                }
                j = j + 1
            }
            i = i + 1
        }
        return [max_row, max_col]
    } else {
        if (axis == 0) {
            # Argmax along columns (reduce rows)
            var rows: int = len(a)
            if (rows == 0) {
                return []
            }
            var cols: int = len(a[0])
            var result: array[int] = []
            var j: int = 0
            while (j < cols) {
                var col_max: float = a[0][j]
                var col_argmax: int = 0
                var i: int = 1
                while (i < rows) {
                    if (a[i][j] > col_max) {
                        col_max = a[i][j]
                        col_argmax = i
                    }
                    i = i + 1
                }
                result = result.append(col_argmax)
                j = j + 1
            }
            return result
        } else {
            if (axis == 1) {
                # Argmax along rows (reduce columns)
                var result: array[int] = []
                var i: int = 0
                var rows: int = len(a)
                while (i < rows) {
                    var row: array[float] = a[i]
                    var cols: int = len(row)
                    if (cols == 0) {
                        result = result.append(0)
                    } else {
                        var row_max: float = row[0]
                        var row_argmax: int = 0
                        var j: int = 1
                        while (j < cols) {
                            if (row[j] > row_max) {
                                row_max = row[j]
                                row_argmax = j
                            }
                            j = j + 1
                        }
                        result = result.append(row_argmax)
                    }
                    i = i + 1
                }
                return result
            } else {
                # Invalid axis
                return []
            }
        }
    }
}

export func matrix_rank(a: matrix[float]) -> int {
    # Calculate the rank of a matrix using numpy's linear algebra.
    # The rank is the number of linearly independent rows/columns.
    var numpy_matrix: any = a  # This will be converted to numpy array by the interpreter
    var rank: int = 0

    # Use numpy's matrix_rank function
    # For now, we'll implement a simple version using SVD
    # The rank is the number of non-zero singular values
    var singular_values: array[float] = matrix_svd(a)
    var i: int = 0
    var len_sv: int = len(singular_values)
    while (i < len_sv) {
        if (singular_values[i] > 1e-10) {  # Small threshold for numerical precision
            rank = rank + 1
        }
        i = i + 1
    }
    return rank
}

export func matrix_svd(a: matrix[float]) -> array[float] {
    # Compute Singular Value Decomposition and return singular values.
    # SVD decomposes A = U * Σ * V^T where Σ contains singular values.
    # For now, we'll return just the singular values as a 1D array.
    var rows: int = len(a)
    var cols: int = len(a[0])
    var min_dim: int = rows
    if (cols < rows) {
        min_dim = cols
    }

    # For a simple implementation, we'll compute eigenvalues of A^T * A
    # The singular values are the square roots of these eigenvalues
    var at_a: matrix[float] = matrix_multiply_transpose(a, a)
    var eigenvalues: array[float] = matrix_eigenvalues(at_a)

    # Take square root of eigenvalues to get singular values
    var singular_values: array[float] = []
    var i: int = 0
    var len_eigen: int = len(eigenvalues)
    while (i < len_eigen) {
        if (eigenvalues[i] > 0) {
            singular_values = singular_values.append(sqrt(eigenvalues[i]))
        }
        i = i + 1
    }

    return singular_values
}

export func matrix_svd_full(a: matrix[float]) -> any {
    # Compute full SVD decomposition: A = U * Σ * V^T
    # Returns a structure with U, S (singular values), and V^T
    var rows: int = len(a)
    var cols: int = len(a[0])
    var min_dim: int = rows
    if (cols < rows) {
        min_dim = cols
    }

    # Get singular values
    var singular_values: array[float] = matrix_svd(a)

    # For now, return U as identity matrix (simplified)
    var u_matrix: matrix[float] = matrix_eye(rows)

    # For now, return V^T as identity matrix (simplified)
    var vt_matrix: matrix[float] = matrix_eye(cols)

    # Return as a simple structure (array with 3 elements)
    var result: array[any] = []
    result = result.append(u_matrix)
    result = result.append(singular_values)
    result = result.append(vt_matrix)

    return result
}

export func matrix_multiply_transpose(a: matrix[float], b: matrix[float]) -> matrix[float] {
    # Helper function to compute A^T * B
    var a_transpose: matrix[float] = transpose(a)
    return a_transpose @ b
}

export func matrix_eigenvalues(a: matrix[float]) -> array[float] {
    # Compute eigenvalues of a square matrix.
    # Currently supports 2x2 and 3x3 matrices.
    var rows: int = len(a)
    var cols: int = len(a[0])

    if (rows != cols) {
        # Non-square matrices don't have eigenvalues in the traditional sense
        return []
    }

    if (rows == 2) {
        # For 2x2 matrix [[a, b], [c, d]], eigenvalues are:
        # λ = (a + d ± sqrt((a - d)² + 4bc)) / 2
        var a11: float = a[0][0]
        var a12: float = a[0][1]
        var a21: float = a[1][0]
        var a22: float = a[1][1]

        var trace: float = a11 + a22
        var det: float = a11 * a22 - a12 * a21
        var discriminant: float = trace * trace - 4 * det

        if (discriminant >= 0) {
            var sqrt_disc: float = sqrt(discriminant)
            var lambda1: float = (trace + sqrt_disc) / 2
            var lambda2: float = (trace - sqrt_disc) / 2
            return [lambda1, lambda2]
        } else {
            # Complex eigenvalues - return real parts for now
            var real_part: float = trace / 2
            return [real_part, real_part]
        }
    } else {
        if (rows == 3) {
            # For 3x3 matrix, use a simplified approach
            # For now, return a simple approximation based on diagonal elements
            var eigenvalues: array[float] = []
            var i: int = 0
            while (i < 3) {
                eigenvalues = eigenvalues.append(a[i][i])
                i = i + 1
            }
            return eigenvalues
        } else {
            # For larger matrices, return empty array for now
            return []
        }
    }
}

export func matrix_eigenvectors(a: matrix[float]) -> matrix[float] {
    # Compute eigenvectors of a square matrix.
    # Currently only supports 2x2 matrices.
    var rows: int = len(a)
    var cols: int = len(a[0])

    if (rows != cols) {
        # Non-square matrices don't have eigenvectors in the traditional sense
        return []
    }

    if (rows == 2) {
        # For 2x2 matrix [[a, b], [c, d]], compute real eigenvectors
        var a11: float = a[0][0]
        var a12: float = a[0][1]
        var a21: float = a[1][0]
        var a22: float = a[1][1]

        # Compute eigenvalues inline to avoid circular dependency
        var trace: float = a11 + a22
        var det: float = a11 * a22 - a12 * a21
        var discriminant: float = trace * trace - 4 * det

        var eigenvalues: array[float] = []
        if (discriminant >= 0) {
            var sqrt_disc: float = sqrt(discriminant)
            var lambda1: float = (trace + sqrt_disc) / 2
            var lambda2: float = (trace - sqrt_disc) / 2
            eigenvalues = eigenvalues.append(lambda1)
            eigenvalues = eigenvalues.append(lambda2)
        } else {
            # Complex eigenvalues - return real parts for now
            var real_part: float = trace / 2
            eigenvalues = eigenvalues.append(real_part)
            eigenvalues = eigenvalues.append(real_part)
        }

        var eigenvectors: matrix[float] = []
        var i: int = 0
        var len_eigen: int = len(eigenvalues)
        while (i < len_eigen) {
            var lambda: float = eigenvalues[i]

            # Solve (A - λI)v = 0 for eigenvector v
            # [[a11-λ, a12], [a21, a22-λ]] * [v1, v2] = [0, 0]
            var eigenvector: array[float] = []

            if (abs(a12) > 1e-10) {
                {
                    eigenvector = eigenvector.append(-a12)
                    eigenvector = eigenvector.append(a11 - lambda)
                }
            } else if (abs(a21) > 1e-10) {
                {
                    eigenvector = eigenvector.append(a22 - lambda)
                    eigenvector = eigenvector.append(-a21)
                }
            } else {
                if (abs(a11 - lambda) < 1e-10) {
                    {
                        eigenvector = eigenvector.append(1.0)
                        eigenvector = eigenvector.append(0.0)
                    }
                } else {
                    {
                        eigenvector = eigenvector.append(0.0)
                        eigenvector = eigenvector.append(1.0)
                    }
                }
            }

            # Normalize eigenvector
            var norm: float = sqrt(eigenvector[0] * eigenvector[0] + eigenvector[1] * eigenvector[1])
            if (norm > 1e-10) {
                {
                    eigenvector[0] = eigenvector[0] / norm
                    eigenvector[1] = eigenvector[1] / norm
                }
            }

            eigenvectors = eigenvectors.append(eigenvector)
            i = i + 1
        }

        return eigenvectors
    } else {
        # For larger matrices, return empty array for now
        return []
    }
}

export func matrix_condition_number(a: matrix[float]) -> float {
    # Calculate the condition number of a matrix.
    # Condition number = max singular value / min singular value
    # Higher condition numbers indicate less numerically stable matrices.
    var singular_values: array[float] = matrix_svd(a)
    var len_sv: int = len(singular_values)

    if (len_sv == 0) {
        return 0.0
    }

    # Find max and min singular values
    var max_sv: float = singular_values[0]
    var min_sv: float = singular_values[0]
    var i: int = 1
    while (i < len_sv) {
        if (singular_values[i] > max_sv) {
            max_sv = singular_values[i]
        }
        if (singular_values[i] < min_sv) {
            min_sv = singular_values[i]
        }
        i = i + 1
    }

    # Avoid division by zero
    if (min_sv < 1e-10) {
        return 1e10  # Very large condition number for singular matrices
    }

    return max_sv / min_sv
}
