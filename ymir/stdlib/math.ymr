module stdlib.math

export PI = 3.141592653589793
export E = 2.718281828459045

export func add(a: int, b: int) -> int {
    return a + b
}

export func subtract(a: int, b: int) -> int {
    return a - b
}

export func multiply(a: int, b: int) -> int {
    return a * b
}

export func divide(a: int, b: int) -> float {
    return a / b
}

# Trigonometric Formulas

export func sin_sum(a: float, b: float) -> float {
    # Calculates sin(a + b)
    return sin(a) * cos(b) + cos(a) * sin(b)
}

export func cos_sum(a: float, b: float) -> float {
    # Calculates cos(a + b)
    return cos(a) * cos(b) - sin(a) * sin(b)
}

export func tan_sum(a: float, b: float) -> float {
    # Calculates tan(a + b)
    return (tan(a) + tan(b)) / (1.0 - tan(a) * tan(b))
}

export func law_of_cosines(a: float, b: float, angle_c_rad: float) -> float {
    # Calculates the length of side c of a triangle given sides a and b,
    # and the angle C between them in radians.
    return sqrt(pow(a, 2.0) + pow(b, 2.0) - 2.0 * a * b * cos(angle_c_rad))
}

# Core Mathematical Enhancements

export func lcm(a: int, b: int) -> int {
    # Calculates the least common multiple of two integers.
    if (a == 0 || b == 0) {
        return 0
    }
    return abs(a * b) / gcd(a, b)
}

export func is_close(a: float, b: float) -> bool {
    # Checks if two floating-point numbers are close to each other using relative and absolute tolerance.
    var rel_tol: float = 1e-9
    var abs_tol: float = 0.0
    # print("is_close debug: a =", a)
    # print("is_close debug: b =", b)
    var abs_a: float = abs(a)
    var abs_b: float = abs(b)
    # print("is_close debug: abs(a) =", abs_a)
    # print("is_close debug: abs(b) =", abs_b)
    var max_abs: float = max(abs_a, abs_b)
    # print("is_close debug: max(abs(a), abs(b)) =", max_abs)
    var diff: float = abs(a - b)
    # print("is_close debug: abs(a - b) =", diff)
    var rel_part: float = rel_tol * max_abs
    # print("is_close debug: rel_tol * max_abs =", rel_part)
    var max_tol: float = max(rel_part, abs_tol)
    # print("is_close debug: max(rel_tol * max_abs, abs_tol) =", max_tol)
    var result: bool = diff <= max_tol
    # print("is_close debug: result =", result)
    return result
}

export func modf(x: float) -> array[float] {
    # Returns the fractional and integer parts of x as a two-item array.
    var integer: float = floor(x)
    var fractional: float = x - integer
    return [fractional, integer]
}

export func combinations(n: int, k: int) -> int {
    # Calculates the number of combinations (nCk).
    if (k < 0 || k > n) {
        return 0
    }
    if (k == 0 || k == n) {
        return 1
    }
    if (k > n / 2) {
        k = n - k
    }
    var res: int = 1
    var i: int = 0
    while (i < k) {
        res = res * (n - i) / (i + 1)
        i = i + 1
    }
    return res
}

export func permutations(n: int, k: int) -> int {
    # Calculates the number of permutations (nPk).
    if (k < 0 || k > n) {
        return 0
    }
    var res: int = 1
    var i: int = 0
    while (i < k) {
        res = res * (n - i)
        i = i + 1
    }
    return res
}

# Matrix Operations

export func matrix_create(rows: int, cols: int, value: float) -> matrix[float] {
    # Creates a matrix with specified dimensions filled with the given value.
    var result: matrix[float] = []
    var i: int = 0
    while (i < rows) {
        var row: array[float] = []
        var j: int = 0
        while (j < cols) {
            row = row.append(value)
            j = j + 1
        }
        result = result.append(row)
        i = i + 1
    }
    return result
}

export func matrix_zeros(rows: int, cols: int) -> matrix[float] {
    # Creates a matrix filled with zeros.
    return matrix_create(rows, cols, 0.0)
}

export func matrix_ones(rows: int, cols: int) -> matrix[float] {
    # Creates a matrix filled with ones.
    return matrix_create(rows, cols, 1.0)
}

export func matrix_eye(n: int) -> matrix[float] {
    # Creates an n x n identity matrix.
    var result: matrix[float] = []
    var i: int = 0
    while (i < n) {
        var row: array[float] = []
        var j: int = 0
        while (j < n) {
            if (i == j) {
                row = row.append(1.0)
            } else {
                row = row.append(0.0)
            }
            j = j + 1
        }
        result = result.append(row)
        i = i + 1
    }
    return result
}

export func matrix_diag(diagonal: array[float]) -> matrix[float] {
    # Creates a square matrix with the given vector as its diagonal.
    var n: int = len(diagonal)
    var result: matrix[float] = []
    var i: int = 0
    while (i < n) {
        var row: array[float] = []
        var j: int = 0
        while (j < n) {
            if (i == j) {
                row = row.append(diagonal[i])
            } else {
                row = row.append(0.0)
            }
            j = j + 1
        }
        result = result.append(row)
        i = i + 1
    }
    return result
}

export func matrix_flatten(a: matrix[float]) -> array[float] {
    # Flattens a matrix to a 1D array (row-major order).
    var result: array[float] = []
    var i: int = 0
    var rows: int = len(a)
    while (i < rows) {
        var row: array[float] = a[i]
        var j: int = 0
        var cols: int = len(row)
        while (j < cols) {
            result = result.append(row[j])
            j = j + 1
        }
        i = i + 1
    }
    return result
}

export func matrix_sum(a: matrix[float], axis: int) -> any {
    # Sum all elements in the matrix.
    # axis = -1 means sum all elements (default)
    # axis = 0 means sum along columns (reduce rows)
    # axis = 1 means sum along rows (reduce columns)
    if (axis == -1) {
        # Sum all elements
        var total: float = 0.0
        var i: int = 0
        var rows: int = len(a)
        while (i < rows) {
            var row: array[float] = a[i]
            var j: int = 0
            var cols: int = len(row)
            while (j < cols) {
                total = total + row[j]
                j = j + 1
            }
            i = i + 1
        }
        return total
    } else {
        if (axis == 0) {
            # Sum along columns (reduce rows)
            var rows: int = len(a)
            if (rows == 0) {
                return 0.0
            }
            var cols: int = len(a[0])
            var result: array[float] = []
            var j: int = 0
            while (j < cols) {
                var col_sum: float = 0.0
                var i: int = 0
                while (i < rows) {
                    col_sum = col_sum + a[i][j]
                    i = i + 1
                }
                result = result.append(col_sum)
                j = j + 1
            }
            return result
        } else {
            if (axis == 1) {
                # Sum along rows (reduce columns)
                var result: array[float] = []
                var i: int = 0
                var rows: int = len(a)
                while (i < rows) {
                    var row: array[float] = a[i]
                    var row_sum: float = 0.0
                    var j: int = 0
                    var cols: int = len(row)
                    while (j < cols) {
                        row_sum = row_sum + row[j]
                        j = j + 1
                    }
                    result = result.append(row_sum)
                    i = i + 1
                }
                return result
            } else {
                # Invalid axis
                return 0.0
            }
        }
    }
}

export func matrix_mean(a: matrix[float], axis: int) -> any {
    # Mean of all elements in the matrix.
    # axis = -1 means mean of all elements (default)
    # axis = 0 means mean along columns (reduce rows)
    # axis = 1 means mean along rows (reduce columns)
    if (axis == -1) {
        # Mean of all elements
        var total: float = matrix_sum(a, -1)
        var rows: int = len(a)
        if (rows == 0) {
            return 0.0
        }
        var cols: int = len(a[0])
        var count: int = rows * cols
        return total / count
    } else {
        if (axis == 0) {
            # Mean along columns (reduce rows)
            var col_sums: array[float] = matrix_sum(a, 0)
            var rows: int = len(a)
            if (rows == 0) {
                return 0.0
            }
            var result: array[float] = []
            var j: int = 0
            var cols: int = len(col_sums)
            while (j < cols) {
                result = result.append(col_sums[j] / rows)
                j = j + 1
            }
            return result
        } else {
            if (axis == 1) {
                # Mean along rows (reduce columns)
                var row_sums: array[float] = matrix_sum(a, 1)
                var result: array[float] = []
                var i: int = 0
                var rows: int = len(row_sums)
                while (i < rows) {
                    var cols: int = len(a[i])
                    result = result.append(row_sums[i] / cols)
                    i = i + 1
                }
                return result
            } else {
                # Invalid axis
                return 0.0
            }
        }
    }
}

export func matrix_var(a: matrix[float], axis: int) -> any {
    # Variance of elements in the matrix.
    # axis = -1 means variance of all elements (default)
    # axis = 0 means variance along columns (reduce rows)
    # axis = 1 means variance along rows (reduce columns)
    if (axis == -1) {
        # Variance of all elements
        var mean_val: float = matrix_mean(a, -1)
        var total_squared_diff: float = 0.0
        var i: int = 0
        var rows: int = len(a)
        var count: int = 0
        while (i < rows) {
            var row: array[float] = a[i]
            var j: int = 0
            var cols: int = len(row)
            while (j < cols) {
                var diff: float = row[j] - mean_val
                total_squared_diff = total_squared_diff + diff * diff
                count = count + 1
                j = j + 1
            }
            i = i + 1
        }
        if (count > 1) {
            return total_squared_diff / (count - 1)
        } else {
            return 0.0
        }
    } else {
        if (axis == 0) {
            # Variance along columns (reduce rows)
            var col_means: array[float] = matrix_mean(a, 0)
            var rows: int = len(a)
            if (rows <= 1) {
                return 0.0
            }
            var cols: int = len(a[0])
            var result: array[float] = []
            var j: int = 0
            while (j < cols) {
                var col_squared_diff: float = 0.0
                var i: int = 0
                while (i < rows) {
                    var diff: float = a[i][j] - col_means[j]
                    col_squared_diff = col_squared_diff + diff * diff
                    i = i + 1
                }
                result = result.append(col_squared_diff / (rows - 1))
                j = j + 1
            }
            return result
        } else {
            if (axis == 1) {
                # Variance along rows (reduce columns)
                var row_means: array[float] = matrix_mean(a, 1)
                var result: array[float] = []
                var i: int = 0
                var rows: int = len(a)
                while (i < rows) {
                    var row: array[float] = a[i]
                    var cols: int = len(row)
                    if (cols <= 1) {
                        result = result.append(0.0)
                    } else {
                        var row_squared_diff: float = 0.0
                        var j: int = 0
                        while (j < cols) {
                            var diff: float = row[j] - row_means[i]
                            row_squared_diff = row_squared_diff + diff * diff
                            j = j + 1
                        }
                        result = result.append(row_squared_diff / (cols - 1))
                    }
                    i = i + 1
                }
                return result
            } else {
                # Invalid axis
                return 0.0
            }
        }
    }
}

export func matrix_std(a: matrix[float], axis: int) -> any {
    # Standard deviation of elements in the matrix.
    # axis = -1 means std of all elements (default)
    # axis = 0 means std along columns (reduce rows)
    # axis = 1 means std along rows (reduce columns)
    var variance: any = matrix_var(a, axis)
    if (axis == -1) {
        return sqrt(variance)
    } else {
        if (axis == 0) {
            var result: array[float] = []
            var i: int = 0
            var len_var: int = len(variance)
            while (i < len_var) {
                result = result.append(sqrt(variance[i]))
                i = i + 1
            }
            return result
        } else {
            if (axis == 1) {
                var result: array[float] = []
                var i: int = 0
                var len_var: int = len(variance)
                while (i < len_var) {
                    result = result.append(sqrt(variance[i]))
                    i = i + 1
                }
                return result
            } else {
                # Invalid axis
                return 0.0
            }
        }
    }
}

export func matrix_min(a: matrix[float], axis: int) -> any {
    # Minimum value of elements in the matrix.
    # axis = -1 means min of all elements (default)
    # axis = 0 means min along columns (reduce rows)
    # axis = 1 means min along rows (reduce columns)
    if (axis == -1) {
        # Min of all elements
        var min_val: float = a[0][0]
        var i: int = 0
        var rows: int = len(a)
        while (i < rows) {
            var row: array[float] = a[i]
            var j: int = 0
            var cols: int = len(row)
            while (j < cols) {
                if (row[j] < min_val) {
                    min_val = row[j]
                }
                j = j + 1
            }
            i = i + 1
        }
        return min_val
    } else {
        if (axis == 0) {
            # Min along columns (reduce rows)
            var rows: int = len(a)
            if (rows == 0) {
                return 0.0
            }
            var cols: int = len(a[0])
            var result: array[float] = []
            var j: int = 0
            while (j < cols) {
                var col_min: float = a[0][j]
                var i: int = 1
                while (i < rows) {
                    if (a[i][j] < col_min) {
                        col_min = a[i][j]
                    }
                    i = i + 1
                }
                result = result.append(col_min)
                j = j + 1
            }
            return result
        } else {
            if (axis == 1) {
                # Min along rows (reduce columns)
                var result: array[float] = []
                var i: int = 0
                var rows: int = len(a)
                while (i < rows) {
                    var row: array[float] = a[i]
                    var cols: int = len(row)
                    if (cols == 0) {
                        result = result.append(0.0)
                    } else {
                        var row_min: float = row[0]
                        var j: int = 1
                        while (j < cols) {
                            if (row[j] < row_min) {
                                row_min = row[j]
                            }
                            j = j + 1
                        }
                        result = result.append(row_min)
                    }
                    i = i + 1
                }
                return result
            } else {
                # Invalid axis
                return 0.0
            }
        }
    }
}

export func matrix_max(a: matrix[float], axis: int) -> any {
    # Maximum value of elements in the matrix.
    # axis = -1 means max of all elements (default)
    # axis = 0 means max along columns (reduce rows)
    # axis = 1 means max along rows (reduce columns)
    if (axis == -1) {
        # Max of all elements
        var max_val: float = a[0][0]
        var i: int = 0
        var rows: int = len(a)
        while (i < rows) {
            var row: array[float] = a[i]
            var j: int = 0
            var cols: int = len(row)
            while (j < cols) {
                if (row[j] > max_val) {
                    max_val = row[j]
                }
                j = j + 1
            }
            i = i + 1
        }
        return max_val
    } else {
        if (axis == 0) {
            # Max along columns (reduce rows)
            var rows: int = len(a)
            if (rows == 0) {
                return 0.0
            }
            var cols: int = len(a[0])
            var result: array[float] = []
            var j: int = 0
            while (j < cols) {
                var col_max: float = a[0][j]
                var i: int = 1
                while (i < rows) {
                    if (a[i][j] > col_max) {
                        col_max = a[i][j]
                    }
                    i = i + 1
                }
                result = result.append(col_max)
                j = j + 1
            }
            return result
        } else {
            if (axis == 1) {
                # Max along rows (reduce columns)
                var result: array[float] = []
                var i: int = 0
                var rows: int = len(a)
                while (i < rows) {
                    var row: array[float] = a[i]
                    var cols: int = len(row)
                    if (cols == 0) {
                        result = result.append(0.0)
                    } else {
                        var row_max: float = row[0]
                        var j: int = 1
                        while (j < cols) {
                            if (row[j] > row_max) {
                                row_max = row[j]
                            }
                            j = j + 1
                        }
                        result = result.append(row_max)
                    }
                    i = i + 1
                }
                return result
            } else {
                # Invalid axis
                return 0.0
            }
        }
    }
}

export func matrix_argmin(a: matrix[float], axis: int) -> any {
    # Index of minimum value of elements in the matrix.
    # axis = -1 means argmin of all elements (returns [row, col])
    # axis = 0 means argmin along columns (returns row indices)
    # axis = 1 means argmin along rows (returns column indices)
    if (axis == -1) {
        # Argmin of all elements
        var min_val: float = a[0][0]
        var min_row: int = 0
        var min_col: int = 0
        var i: int = 0
        var rows: int = len(a)
        while (i < rows) {
            var row: array[float] = a[i]
            var j: int = 0
            var cols: int = len(row)
            while (j < cols) {
                if (row[j] < min_val) {
                    min_val = row[j]
                    min_row = i
                    min_col = j
                }
                j = j + 1
            }
            i = i + 1
        }
        return [min_row, min_col]
    } else {
        if (axis == 0) {
            # Argmin along columns (reduce rows)
            var rows: int = len(a)
            if (rows == 0) {
                return []
            }
            var cols: int = len(a[0])
            var result: array[int] = []
            var j: int = 0
            while (j < cols) {
                var col_min: float = a[0][j]
                var col_argmin: int = 0
                var i: int = 1
                while (i < rows) {
                    if (a[i][j] < col_min) {
                        col_min = a[i][j]
                        col_argmin = i
                    }
                    i = i + 1
                }
                result = result.append(col_argmin)
                j = j + 1
            }
            return result
        } else {
            if (axis == 1) {
                # Argmin along rows (reduce columns)
                var result: array[int] = []
                var i: int = 0
                var rows: int = len(a)
                while (i < rows) {
                    var row: array[float] = a[i]
                    var cols: int = len(row)
                    if (cols == 0) {
                        result = result.append(0)
                    } else {
                        var row_min: float = row[0]
                        var row_argmin: int = 0
                        var j: int = 1
                        while (j < cols) {
                            if (row[j] < row_min) {
                                row_min = row[j]
                                row_argmin = j
                            }
                            j = j + 1
                        }
                        result = result.append(row_argmin)
                    }
                    i = i + 1
                }
                return result
            } else {
                # Invalid axis
                return []
            }
        }
    }
}

export func matrix_argmax(a: matrix[float], axis: int) -> any {
    # Index of maximum value of elements in the matrix.
    # axis = -1 means argmax of all elements (returns [row, col])
    # axis = 0 means argmax along columns (returns row indices)
    # axis = 1 means argmax along rows (returns column indices)
    if (axis == -1) {
        # Argmax of all elements
        var max_val: float = a[0][0]
        var max_row: int = 0
        var max_col: int = 0
        var i: int = 0
        var rows: int = len(a)
        while (i < rows) {
            var row: array[float] = a[i]
            var j: int = 0
            var cols: int = len(row)
