module stdlib.math

export PI = 3.141592653589793
export E = 2.718281828459045

export func add(a: int, b: int) -> int {
    return a + b
}

export func subtract(a: int, b: int) -> int {
    return a - b
}

export func multiply(a: int, b: int) -> int {
    return a * b
}

export func divide(a: int, b: int) -> float {
    return a / b
}

# Trigonometric Formulas

export func sin_sum(a: float, b: float) -> float {
    # Calculates sin(a + b)
    return sin(a) * cos(b) + cos(a) * sin(b)
}

export func cos_sum(a: float, b: float) -> float {
    # Calculates cos(a + b)
    return cos(a) * cos(b) - sin(a) * sin(b)
}

export func tan_sum(a: float, b: float) -> float {
    # Calculates tan(a + b)
    return (tan(a) + tan(b)) / (1.0 - tan(a) * tan(b))
}

export func law_of_cosines(a: float, b: float, angle_c_rad: float) -> float {
    # Calculates the length of side c of a triangle given sides a and b,
    # and the angle C between them in radians.
    return sqrt(pow(a, 2.0) + pow(b, 2.0) - 2.0 * a * b * cos(angle_c_rad))
}

# Core Mathematical Enhancements

export func lcm(a: int, b: int) -> int {
    # Calculates the least common multiple of two integers.
    if (a == 0 || b == 0) {
        return 0
    }
    return abs(a * b) / gcd(a, b)
}

export func is_close(a: float, b: float) -> bool {
    # Checks if two floating-point numbers are close to each other using relative and absolute tolerance.
    var rel_tol: float = 1e-9
    var abs_tol: float = 0.0
    # print("is_close debug: a =", a)
    # print("is_close debug: b =", b)
    var abs_a: float = abs(a)
    var abs_b: float = abs(b)
    # print("is_close debug: abs(a) =", abs_a)
    # print("is_close debug: abs(b) =", abs_b)
    var max_abs: float = max(abs_a, abs_b)
    # print("is_close debug: max(abs(a), abs(b)) =", max_abs)
    var diff: float = abs(a - b)
    # print("is_close debug: abs(a - b) =", diff)
    var rel_part: float = rel_tol * max_abs
    # print("is_close debug: rel_tol * max_abs =", rel_part)
    var max_tol: float = max(rel_part, abs_tol)
    # print("is_close debug: max(rel_tol * max_abs, abs_tol) =", max_tol)
    var result: bool = diff <= max_tol
    # print("is_close debug: result =", result)
    return result
}

export func modf(x: float) -> array[float] {
    # Returns the fractional and integer parts of x as a two-item array.
    var integer: float = floor(x)
    var fractional: float = x - integer
    return [fractional, integer]
}

export func combinations(n: int, k: int) -> int {
    # Calculates the number of combinations (nCk).
    if (k < 0 || k > n) {
        return 0
    }
    if (k == 0 || k == n) {
        return 1
    }
    if (k > n / 2) {
        k = n - k
    }
    var res: int = 1
    var i: int = 0
    while (i < k) {
        res = res * (n - i) / (i + 1)
        i = i + 1
    }
    return res
}

export func permutations(n: int, k: int) -> int {
    # Calculates the number of permutations (nPk).
    if (k < 0 || k > n) {
        return 0
    }
    var res: int = 1
    var i: int = 0
    while (i < k) {
        res = res * (n - i)
        i = i + 1
    }
    return res
}

# Matrix Operations

export func matrix_create(rows: int, cols: int, value: float) -> matrix[float] {
    # Creates a matrix with specified dimensions filled with the given value.
    var result: matrix[float] = []
    var i: int = 0
    while (i < rows) {
        var row: array[float] = []
        var j: int = 0
        while (j < cols) {
            row = row.append(value)
            j = j + 1
        }
        result = result.append(row)
        i = i + 1
    }
    return result
}

export func matrix_zeros(rows: int, cols: int) -> matrix[float] {
    # Creates a matrix filled with zeros.
    return matrix_create(rows, cols, 0.0)
}

export func matrix_ones(rows: int, cols: int) -> matrix[float] {
    # Creates a matrix filled with ones.
    return matrix_create(rows, cols, 1.0)
}

export func matrix_eye(n: int) -> matrix[float] {
    # Creates an n x n identity matrix.
    var result: matrix[float] = []
    var i: int = 0
    while (i < n) {
        var row: array[float] = []
        var j: int = 0
        while (j < n) {
            if (i == j) {
                row = row.append(1.0)
            } else {
                row = row.append(0.0)
            }
            j = j + 1
        }
        result = result.append(row)
        i = i + 1
    }
    return result
}

export func matrix_diag(diagonal: array[float]) -> matrix[float] {
    # Creates a square matrix with the given vector as its diagonal.
    var n: int = len(diagonal)
    var result: matrix[float] = []
    var i: int = 0
    while (i < n) {
        var row: array[float] = []
        var j: int = 0
        while (j < n) {
            if (i == j) {
                row = row.append(diagonal[i])
            } else {
                row = row.append(0.0)
            }
            j = j + 1
        }
        result = result.append(row)
        i = i + 1
    }
    return result
}

export func matrix_flatten(a: matrix[float]) -> array[float] {
    # Flattens a matrix to a 1D array (row-major order).
    var result: array[float] = []
    var i: int = 0
    var rows: int = len(a)
    while (i < rows) {
        var row: array[float] = a[i]
        var j: int = 0
        var cols: int = len(row)
        while (j < cols) {
            result = result.append(row[j])
            j = j + 1
        }
        i = i + 1
    }
    return result
}
