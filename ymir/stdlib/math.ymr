module stdlib.math

export PI = 3.141592653589793
export E = 2.718281828459045

export func add(a: int, b: int) -> int {
    return a + b
}

export func subtract(a: int, b: int) -> int {
    return a - b
}

export func multiply(a: int, b: int) -> int {
    return a * b
}

export func divide(a: int, b: int) -> float {
    return a / b
}

# Trigonometric Formulas

export func sin_sum(a: float, b: float) -> float {
    # Calculates sin(a + b)
    return sin(a) * cos(b) + cos(a) * sin(b)
}

export func cos_sum(a: float, b: float) -> float {
    # Calculates cos(a + b)
    return cos(a) * cos(b) - sin(a) * sin(b)
}

export func tan_sum(a: float, b: float) -> float {
    # Calculates tan(a + b)
    return (tan(a) + tan(b)) / (1.0 - tan(a) * tan(b))
}

export func law_of_cosines(a: float, b: float, angle_c_rad: float) -> float {
    # Calculates the length of side c of a triangle given sides a and b,
    # and the angle C between them in radians.
    return sqrt(pow(a, 2.0) + pow(b, 2.0) - 2.0 * a * b * cos(angle_c_rad))
}

# Core Mathematical Enhancements

export func lcm(a: int, b: int) -> int {
    # Calculates the least common multiple of two integers.
    if (a == 0 || b == 0) {
        return 0
    }
    return abs(a * b) / gcd(a, b)
}

export func is_close(a: float, b: float) -> bool {
    # Checks if two floating-point numbers are close to each other using relative and absolute tolerance.
    var rel_tol: float = 1e-9
    var abs_tol: float = 0.0
    # print("is_close debug: a =", a)
    # print("is_close debug: b =", b)
    var abs_a: float = abs(a)
    var abs_b: float = abs(b)
    # print("is_close debug: abs(a) =", abs_a)
    # print("is_close debug: abs(b) =", abs_b)
    var max_abs: float = max(abs_a, abs_b)
    # print("is_close debug: max(abs(a), abs(b)) =", max_abs)
    var diff: float = abs(a - b)
    # print("is_close debug: abs(a - b) =", diff)
    var rel_part: float = rel_tol * max_abs
    # print("is_close debug: rel_tol * max_abs =", rel_part)
    var max_tol: float = max(rel_part, abs_tol)
    # print("is_close debug: max(rel_tol * max_abs, abs_tol) =", max_tol)
    var result: bool = diff <= max_tol
    # print("is_close debug: result =", result)
    return result
}

export func modf(x: float) -> array[float] {
    # Returns the fractional and integer parts of x as a two-item array.
    var integer: float = floor(x)
    var fractional: float = x - integer
    return [fractional, integer]
}

export func combinations(n: int, k: int) -> int {
    # Calculates the number of combinations (nCk).
    if (k < 0 || k > n) {
        return 0
    }
    if (k == 0 || k == n) {
        return 1
    }
    if (k > n / 2) {
        k = n - k
    }
    var res: int = 1
    var i: int = 0
    while (i < k) {
        res = res * (n - i) / (i + 1)
        i = i + 1
    }
    return res
}

export func permutations(n: int, k: int) -> int {
    # Calculates the number of permutations (nPk).
    if (k < 0 || k > n) {
        return 0
    }
    var res: int = 1
    var i: int = 0
    while (i < k) {
        res = res * (n - i)
        i = i + 1
    }
    return res
}

export func factorial(n: int) -> int {
    # Calculate factorial: n! = n * (n-1) * ... * 2 * 1
    if (n < 0) {
        return 0
    }
    if (n == 0 || n == 1) {
        return 1
    }
    
    var result: int = 1
    var i: int = 2
    while (i <= n) {
        result = result * i
        i = i + 1
    }
    return result
}

# Matrix Operations

export func matrix_create(rows: int, cols: int, value: float) -> matrix[float] {
    # Creates a matrix with specified dimensions filled with the given value.
    var result: matrix[float] = []
    var i: int = 0
    while (i < rows) {
        var row: array[float] = []
        var j: int = 0
        while (j < cols) {
            row = row.append(value)
            j = j + 1
        }
        result = result.append(row)
        i = i + 1
    }
    return result
}

export func matrix_zeros(rows: int, cols: int) -> matrix[float] {
    # Creates a matrix filled with zeros.
    return matrix_create(rows, cols, 0.0)
}

export func matrix_ones(rows: int, cols: int) -> matrix[float] {
    # Creates a matrix filled with ones.
    return matrix_create(rows, cols, 1.0)
}

export func matrix_eye(n: int) -> matrix[float] {
    # Creates an n x n identity matrix.
    var result: matrix[float] = []
    var i: int = 0
    while (i < n) {
        var row: array[float] = []
        var j: int = 0
        while (j < n) {
            if (i == j) {
                row = row.append(1.0)
            } else {
                row = row.append(0.0)
            }
            j = j + 1
        }
        result = result.append(row)
        i = i + 1
    }
    return result
}

export func matrix_diag(diagonal: array[float]) -> matrix[float] {
    # Creates a square matrix with the given vector as its diagonal.
    var n: int = len(diagonal)
    var result: matrix[float] = []
    var i: int = 0
    while (i < n) {
        var row: array[float] = []
        var j: int = 0
        while (j < n) {
            if (i == j) {
                row = row.append(diagonal[i])
            } else {
                row = row.append(0.0)
            }
            j = j + 1
        }
        result = result.append(row)
        i = i + 1
    }
    return result
}

export func matrix_flatten(a: matrix[float]) -> array[float] {
    # Flattens a matrix to a 1D array (row-major order).
    var result: array[float] = []
    var i: int = 0
    var rows: int = len(a)
    while (i < rows) {
        var row: array[float] = a[i]
        var j: int = 0
        var cols: int = len(row)
        while (j < cols) {
            result = result.append(row[j])
            j = j + 1
        }
        i = i + 1
    }
    return result
}

export func matrix_sum(a: matrix[float], axis: int) -> any {
    # Sum all elements in the matrix.
    # axis = -1 means sum all elements (default)
    # axis = 0 means sum along columns (reduce rows)
    # axis = 1 means sum along rows (reduce columns)
    if (axis == -1) {
        # Sum all elements
        var total: float = 0.0
        var i: int = 0
        var rows: int = len(a)
        while (i < rows) {
            var row: array[float] = a[i]
            var j: int = 0
            var cols: int = len(row)
            while (j < cols) {
                total = total + row[j]
                j = j + 1
            }
            i = i + 1
        }
        return total
    } else {
        if (axis == 0) {
            # Sum along columns (reduce rows)
            var rows: int = len(a)
            if (rows == 0) {
                return 0.0
            }
            var cols: int = len(a[0])
            var result: array[float] = []
            var j: int = 0
            while (j < cols) {
                var col_sum: float = 0.0
                var i: int = 0
                while (i < rows) {
                    col_sum = col_sum + a[i][j]
                    i = i + 1
                }
                result = result.append(col_sum)
                j = j + 1
            }
            return result
        } else {
            if (axis == 1) {
                # Sum along rows (reduce columns)
                var result: array[float] = []
                var i: int = 0
                var rows: int = len(a)
                while (i < rows) {
                    var row: array[float] = a[i]
                    var row_sum: float = 0.0
                    var j: int = 0
                    var cols: int = len(row)
                    while (j < cols) {
                        row_sum = row_sum + row[j]
                        j = j + 1
                    }
                    result = result.append(row_sum)
                    i = i + 1
                }
                return result
            } else {
                # Invalid axis
                return 0.0
            }
        }
    }
}

export func matrix_mean(a: matrix[float], axis: int) -> any {
    # Mean of all elements in the matrix.
    # axis = -1 means mean of all elements (default)
    # axis = 0 means mean along columns (reduce rows)
    # axis = 1 means mean along rows (reduce columns)
    if (axis == -1) {
        # Mean of all elements
        var total: float = matrix_sum(a, -1)
        var rows: int = len(a)
        if (rows == 0) {
            return 0.0
        }
        var cols: int = len(a[0])
        var count: int = rows * cols
        return total / count
    } else {
        if (axis == 0) {
            # Mean along columns (reduce rows)
            var col_sums: array[float] = matrix_sum(a, 0)
            var rows: int = len(a)
            if (rows == 0) {
                return 0.0
            }
            var result: array[float] = []
            var j: int = 0
            var cols: int = len(col_sums)
            while (j < cols) {
                result = result.append(col_sums[j] / rows)
                j = j + 1
            }
            return result
        } else {
            if (axis == 1) {
                # Mean along rows (reduce columns)
                var row_sums: array[float] = matrix_sum(a, 1)
                var result: array[float] = []
                var i: int = 0
                var rows: int = len(row_sums)
                while (i < rows) {
                    var cols: int = len(a[i])
                    result = result.append(row_sums[i] / cols)
                    i = i + 1
                }
                return result
            } else {
                # Invalid axis
                return 0.0
            }
        }
    }
}

export func matrix_var(a: matrix[float], axis: int) -> any {
    # Variance of elements in the matrix.
    # axis = -1 means variance of all elements (default)
    # axis = 0 means variance along columns (reduce rows)
    # axis = 1 means variance along rows (reduce columns)
    if (axis == -1) {
        # Variance of all elements
        var mean_val: float = matrix_mean(a, -1)
        var total_squared_diff: float = 0.0
        var i: int = 0
        var rows: int = len(a)
        var count: int = 0
        while (i < rows) {
            var row: array[float] = a[i]
            var j: int = 0
            var cols: int = len(row)
            while (j < cols) {
                var diff: float = row[j] - mean_val
                total_squared_diff = total_squared_diff + diff * diff
                count = count + 1
                j = j + 1
            }
            i = i + 1
        }
        if (count > 1) {
            return total_squared_diff / (count - 1)
        } else {
            return 0.0
        }
    } else {
        if (axis == 0) {
            # Variance along columns (reduce rows)
            var col_means: array[float] = matrix_mean(a, 0)
            var rows: int = len(a)
            if (rows <= 1) {
                return 0.0
            }
            var cols: int = len(a[0])
            var result: array[float] = []
            var j: int = 0
            while (j < cols) {
                var col_squared_diff: float = 0.0
                var i: int = 0
                while (i < rows) {
                    var diff: float = a[i][j] - col_means[j]
                    col_squared_diff = col_squared_diff + diff * diff
                    i = i + 1
                }
                result = result.append(col_squared_diff / (rows - 1))
                j = j + 1
            }
            return result
        } else {
            if (axis == 1) {
                # Variance along rows (reduce columns)
                var row_means: array[float] = matrix_mean(a, 1)
                var result: array[float] = []
                var i: int = 0
                var rows: int = len(a)
                while (i < rows) {
                    var row: array[float] = a[i]
                    var cols: int = len(row)
                    if (cols <= 1) {
                        result = result.append(0.0)
                    } else {
                        var row_squared_diff: float = 0.0
                        var j: int = 0
                        while (j < cols) {
                            var diff: float = row[j] - row_means[i]
                            row_squared_diff = row_squared_diff + diff * diff
                            j = j + 1
                        }
                        result = result.append(row_squared_diff / (cols - 1))
                    }
                    i = i + 1
                }
                return result
            } else {
                # Invalid axis
                return 0.0
            }
        }
    }
}

export func matrix_std(a: matrix[float], axis: int) -> any {
    # Standard deviation of elements in the matrix.
    # axis = -1 means std of all elements (default)
    # axis = 0 means std along columns (reduce rows)
    # axis = 1 means std along rows (reduce columns)
    var variance: any = matrix_var(a, axis)
    if (axis == -1) {
        return sqrt(variance)
    } else {
        if (axis == 0) {
            var result: array[float] = []
            var i: int = 0
            var len_var: int = len(variance)
            while (i < len_var) {
                result = result.append(sqrt(variance[i]))
                i = i + 1
            }
            return result
        } else {
            if (axis == 1) {
                var result: array[float] = []
                var i: int = 0
                var len_var: int = len(variance)
                while (i < len_var) {
                    result = result.append(sqrt(variance[i]))
                    i = i + 1
                }
                return result
            } else {
                # Invalid axis
                return 0.0
            }
        }
    }
}

export func matrix_min(a: matrix[float], axis: int) -> any {
    # Minimum value of elements in the matrix.
    # axis = -1 means min of all elements (default)
    # axis = 0 means min along columns (reduce rows)
    # axis = 1 means min along rows (reduce columns)
    if (axis == -1) {
        # Min of all elements
        var min_val: float = a[0][0]
        var i: int = 0
        var rows: int = len(a)
        while (i < rows) {
            var row: array[float] = a[i]
            var j: int = 0
            var cols: int = len(row)
            while (j < cols) {
                if (row[j] < min_val) {
                    min_val = row[j]
                }
                j = j + 1
            }
            i = i + 1
        }
        return min_val
    } else {
        if (axis == 0) {
            # Min along columns (reduce rows)
            var rows: int = len(a)
            if (rows == 0) {
                return 0.0
            }
            var cols: int = len(a[0])
            var result: array[float] = []
            var j: int = 0
            while (j < cols) {
                var col_min: float = a[0][j]
                var i: int = 1
                while (i < rows) {
                    if (a[i][j] < col_min) {
                        col_min = a[i][j]
                    }
                    i = i + 1
                }
                result = result.append(col_min)
                j = j + 1
            }
            return result
        } else {
            if (axis == 1) {
                # Min along rows (reduce columns)
                var result: array[float] = []
                var i: int = 0
                var rows: int = len(a)
                while (i < rows) {
                    var row: array[float] = a[i]
                    var cols: int = len(row)
                    if (cols == 0) {
                        result = result.append(0.0)
                    } else {
                        var row_min: float = row[0]
                        var j: int = 1
                        while (j < cols) {
                            if (row[j] < row_min) {
                                row_min = row[j]
                            }
                            j = j + 1
                        }
                        result = result.append(row_min)
                    }
                    i = i + 1
                }
                return result
            } else {
                # Invalid axis
                return 0.0
            }
        }
    }
}

export func matrix_max(a: matrix[float], axis: int) -> any {
    # Maximum value of elements in the matrix.
    # axis = -1 means max of all elements (default)
    # axis = 0 means max along columns (reduce rows)
    # axis = 1 means max along rows (reduce columns)
    if (axis == -1) {
        # Max of all elements
        var max_val: float = a[0][0]
        var i: int = 0
        var rows: int = len(a)
        while (i < rows) {
            var row: array[float] = a[i]
            var j: int = 0
            var cols: int = len(row)
            while (j < cols) {
                if (row[j] > max_val) {
                    max_val = row[j]
                }
                j = j + 1
            }
            i = i + 1
        }
        return max_val
    } else {
        if (axis == 0) {
            # Max along columns (reduce rows)
            var rows: int = len(a)
            if (rows == 0) {
                return 0.0
            }
            var cols: int = len(a[0])
            var result: array[float] = []
            var j: int = 0
            while (j < cols) {
                var col_max: float = a[0][j]
                var i: int = 1
                while (i < rows) {
                    if (a[i][j] > col_max) {
                        col_max = a[i][j]
                    }
                    i = i + 1
                }
                result = result.append(col_max)
                j = j + 1
            }
            return result
        } else {
            if (axis == 1) {
                # Max along rows (reduce columns)
                var result: array[float] = []
                var i: int = 0
                var rows: int = len(a)
                while (i < rows) {
                    var row: array[float] = a[i]
                    var cols: int = len(row)
                    if (cols == 0) {
                        result = result.append(0.0)
                    } else {
                        var row_max: float = row[0]
                        var j: int = 1
                        while (j < cols) {
                            if (row[j] > row_max) {
                                row_max = row[j]
                            }
                            j = j + 1
                        }
                        result = result.append(row_max)
                    }
                    i = i + 1
                }
                return result
            } else {
                # Invalid axis
                return 0.0
            }
        }
    }
}

export func matrix_argmin(a: matrix[float], axis: int) -> any {
    # Index of minimum value of elements in the matrix.
    # axis = -1 means argmin of all elements (returns [row, col])
    # axis = 0 means argmin along columns (returns row indices)
    # axis = 1 means argmin along rows (returns column indices)
    if (axis == -1) {
        # Argmin of all elements
        var min_val: float = a[0][0]
        var min_row: int = 0
        var min_col: int = 0
        var i: int = 0
        var rows: int = len(a)
        while (i < rows) {
            var row: array[float] = a[i]
            var j: int = 0
            var cols: int = len(row)
            while (j < cols) {
                if (row[j] < min_val) {
                    min_val = row[j]
                    min_row = i
                    min_col = j
                }
                j = j + 1
            }
            i = i + 1
        }
        return [min_row, min_col]
    } else {
        if (axis == 0) {
            # Argmin along columns (reduce rows)
            var rows: int = len(a)
            if (rows == 0) {
                return []
            }
            var cols: int = len(a[0])
            var result: array[int] = []
            var j: int = 0
            while (j < cols) {
                var col_min: float = a[0][j]
                var col_argmin: int = 0
                var i: int = 1
                while (i < rows) {
                    if (a[i][j] < col_min) {
                        col_min = a[i][j]
                        col_argmin = i
                    }
                    i = i + 1
                }
                result = result.append(col_argmin)
                j = j + 1
            }
            return result
        } else {
            if (axis == 1) {
                # Argmin along rows (reduce columns)
                var result: array[int] = []
                var i: int = 0
                var rows: int = len(a)
                while (i < rows) {
                    var row: array[float] = a[i]
                    var cols: int = len(row)
                    if (cols == 0) {
                        result = result.append(0)
                    } else {
                        var row_min: float = row[0]
                        var row_argmin: int = 0
                        var j: int = 1
                        while (j < cols) {
                            if (row[j] < row_min) {
                                row_min = row[j]
                                row_argmin = j
                            }
                            j = j + 1
                        }
                        result = result.append(row_argmin)
                    }
                    i = i + 1
                }
                return result
            } else {
                # Invalid axis
                return []
            }
        }
    }
}

export func matrix_argmax(a: matrix[float], axis: int) -> any {
    # Index of maximum value of elements in the matrix.
    # axis = -1 means argmax of all elements (returns [row, col])
    # axis = 0 means argmax along columns (returns row indices)
    # axis = 1 means argmax along rows (returns column indices)
    if (axis == -1) {
        # Argmax of all elements
        var max_val: float = a[0][0]
        var max_row: int = 0
        var max_col: int = 0
        var i: int = 0
        var rows: int = len(a)
        while (i < rows) {
            var row: array[float] = a[i]
            var j: int = 0
            var cols: int = len(row)
            while (j < cols) {
                if (row[j] > max_val) {
                    max_val = row[j]
                    max_row = i
                    max_col = j
                }
                j = j + 1
            }
            i = i + 1
        }
        return [max_row, max_col]
    } else {
        if (axis == 0) {
            # Argmax along columns (reduce rows)
            var rows: int = len(a)
            if (rows == 0) {
                return []
            }
            var cols: int = len(a[0])
            var result: array[int] = []
            var j: int = 0
            while (j < cols) {
                var col_max: float = a[0][j]
                var col_argmax: int = 0
                var i: int = 1
                while (i < rows) {
                    if (a[i][j] > col_max) {
                        col_max = a[i][j]
                        col_argmax = i
                    }
                    i = i + 1
                }
                result = result.append(col_argmax)
                j = j + 1
            }
            return result
        } else {
            if (axis == 1) {
                # Argmax along rows (reduce columns)
                var result: array[int] = []
                var i: int = 0
                var rows: int = len(a)
                while (i < rows) {
                    var row: array[float] = a[i]
                    var cols: int = len(row)
                    if (cols == 0) {
                        result = result.append(0)
                    } else {
                        var row_max: float = row[0]
                        var row_argmax: int = 0
                        var j: int = 1
                        while (j < cols) {
                            if (row[j] > row_max) {
                                row_max = row[j]
                                row_argmax = j
                            }
                            j = j + 1
                        }
                        result = result.append(row_argmax)
                    }
                    i = i + 1
                }
                return result
            } else {
                # Invalid axis
                return []
            }
        }
    }
}

export func matrix_rank(a: matrix[float]) -> int {
    # Calculate the rank of a matrix using numpy's linear algebra.
    # The rank is the number of linearly independent rows/columns.
    var numpy_matrix: any = a  # This will be converted to numpy array by the interpreter
    var rank: int = 0

    # Use numpy's matrix_rank function
    # For now, we'll implement a simple version using SVD
    # The rank is the number of non-zero singular values
    var singular_values: array[float] = matrix_svd(a)
    var i: int = 0
    var len_sv: int = len(singular_values)
    while (i < len_sv) {
        if (singular_values[i] > 1e-10) {  # Small threshold for numerical precision
            rank = rank + 1
        }
        i = i + 1
    }
    return rank
}

export func matrix_svd(a: matrix[float]) -> array[float] {
    # Compute Singular Value Decomposition and return singular values.
    # SVD decomposes A = U * Σ * V^T where Σ contains singular values.
    # For now, we'll return just the singular values as a 1D array.
    var rows: int = len(a)
    var cols: int = len(a[0])
    var min_dim: int = rows
    if (cols < rows) {
        min_dim = cols
    }

    # For a simple implementation, we'll compute eigenvalues of A^T * A
    # The singular values are the square roots of these eigenvalues
    var at_a: matrix[float] = matrix_multiply_transpose(a, a)
    var eigenvalues: array[float] = matrix_eigenvalues(at_a)

    # Take square root of eigenvalues to get singular values
    var singular_values: array[float] = []
    var i: int = 0
    var len_eigen: int = len(eigenvalues)
    while (i < len_eigen) {
        if (eigenvalues[i] > 0) {
            singular_values = singular_values.append(sqrt(eigenvalues[i]))
        }
        i = i + 1
    }

    return singular_values
}

export func matrix_svd_full(a: matrix[float]) -> any {
    # Compute full SVD decomposition: A = U * Σ * V^T
    # Returns a structure with U, S (singular values), and V^T
    var rows: int = len(a)
    var cols: int = len(a[0])
    var min_dim: int = rows
    if (cols < rows) {
        min_dim = cols
    }

    # Get singular values
    var singular_values: array[float] = matrix_svd(a)

    # For now, return U as identity matrix (simplified)
    var u_matrix: matrix[float] = matrix_eye(rows)

    # For now, return V^T as identity matrix (simplified)
    var vt_matrix: matrix[float] = matrix_eye(cols)

    # Return as a simple structure (array with 3 elements)
    var result: array[any] = []
    result = result.append(u_matrix)
    result = result.append(singular_values)
    result = result.append(vt_matrix)

    return result
}

export func matrix_multiply_transpose(a: matrix[float], b: matrix[float]) -> matrix[float] {
    # Helper function to compute A^T * B
    var a_transpose: matrix[float] = transpose(a)
    return a_transpose @ b
}

export func matrix_eigenvalues(a: matrix[float]) -> array[float] {
    # Compute eigenvalues of a square matrix.
    # Currently supports 2x2 and 3x3 matrices.
    var rows: int = len(a)
    var cols: int = len(a[0])

    if (rows != cols) {
        # Non-square matrices don't have eigenvalues in the traditional sense
        return []
    }

    if (rows == 2) {
        # For 2x2 matrix [[a, b], [c, d]], eigenvalues are:
        # λ = (a + d ± sqrt((a - d)² + 4bc)) / 2
        var a11: float = a[0][0]
        var a12: float = a[0][1]
        var a21: float = a[1][0]
        var a22: float = a[1][1]

        var trace: float = a11 + a22
        var det: float = a11 * a22 - a12 * a21
        var discriminant: float = trace * trace - 4 * det

        if (discriminant >= 0) {
            var sqrt_disc: float = sqrt(discriminant)
            var lambda1: float = (trace + sqrt_disc) / 2
            var lambda2: float = (trace - sqrt_disc) / 2
            return [lambda1, lambda2]
        } else {
            # Complex eigenvalues - return real parts for now
            var real_part: float = trace / 2
            return [real_part, real_part]
        }
    } else {
        if (rows == 3) {
            # For 3x3 matrix, use a simplified approach
            # For now, return a simple approximation based on diagonal elements
            var eigenvalues: array[float] = []
            var i: int = 0
            while (i < 3) {
                eigenvalues = eigenvalues.append(a[i][i])
                i = i + 1
            }
            return eigenvalues
        } else {
            # For larger matrices, return empty array for now
            return []
        }
    }
}

export func matrix_eigenvectors(a: matrix[float]) -> matrix[float] {
    # Compute eigenvectors of a square matrix.
    # Currently only supports 2x2 matrices.
    var rows: int = len(a)
    var cols: int = len(a[0])

    if (rows != cols) {
        # Non-square matrices don't have eigenvectors in the traditional sense
        return []
    }

    if (rows == 2) {
        # For 2x2 matrix [[a, b], [c, d]], compute real eigenvectors
        var a11: float = a[0][0]
        var a12: float = a[0][1]
        var a21: float = a[1][0]
        var a22: float = a[1][1]

        # Compute eigenvalues inline to avoid circular dependency
        var trace: float = a11 + a22
        var det: float = a11 * a22 - a12 * a21
        var discriminant: float = trace * trace - 4 * det

        var eigenvalues: array[float] = []
        if (discriminant >= 0) {
            var sqrt_disc: float = sqrt(discriminant)
            var lambda1: float = (trace + sqrt_disc) / 2
            var lambda2: float = (trace - sqrt_disc) / 2
            eigenvalues = eigenvalues.append(lambda1)
            eigenvalues = eigenvalues.append(lambda2)
        } else {
            # Complex eigenvalues - return real parts for now
            var real_part: float = trace / 2
            eigenvalues = eigenvalues.append(real_part)
            eigenvalues = eigenvalues.append(real_part)
        }

        var eigenvectors: matrix[float] = []
        var i: int = 0
        var len_eigen: int = len(eigenvalues)
        while (i < len_eigen) {
            var lambda: float = eigenvalues[i]

            # Solve (A - λI)v = 0 for eigenvector v
            # [[a11-λ, a12], [a21, a22-λ]] * [v1, v2] = [0, 0]
            var eigenvector: array[float] = []

            if (abs(a12) > 1e-10) {
                {
                    eigenvector = eigenvector.append(-a12)
                    eigenvector = eigenvector.append(a11 - lambda)
                }
            } else if (abs(a21) > 1e-10) {
                {
                    eigenvector = eigenvector.append(a22 - lambda)
                    eigenvector = eigenvector.append(-a21)
                }
            } else {
                if (abs(a11 - lambda) < 1e-10) {
                    {
                        eigenvector = eigenvector.append(1.0)
                        eigenvector = eigenvector.append(0.0)
                    }
                } else {
                    {
                        eigenvector = eigenvector.append(0.0)
                        eigenvector = eigenvector.append(1.0)
                    }
                }
            }

            # Normalize eigenvector
            var norm: float = sqrt(eigenvector[0] * eigenvector[0] + eigenvector[1] * eigenvector[1])
            if (norm > 1e-10) {
                {
                    eigenvector[0] = eigenvector[0] / norm
                    eigenvector[1] = eigenvector[1] / norm
                }
            }

            eigenvectors = eigenvectors.append(eigenvector)
            i = i + 1
        }

        return eigenvectors
    } else {
        # For larger matrices, return empty array for now
        return []
    }
}

export func matrix_condition_number(a: matrix[float]) -> float {
    # Calculate the condition number of a matrix.
    # Condition number = max singular value / min singular value
    # Higher condition numbers indicate less numerically stable matrices.
    var singular_values: array[float] = matrix_svd(a)
    var len_sv: int = len(singular_values)

    if (len_sv == 0) {
        return 0.0
    }

    # Find max and min singular values
    var max_sv: float = singular_values[0]
    var min_sv: float = singular_values[0]
    var i: int = 1
    while (i < len_sv) {
        if (singular_values[i] > max_sv) {
            max_sv = singular_values[i]
        }
        if (singular_values[i] < min_sv) {
            min_sv = singular_values[i]
        }
        i = i + 1
    }

    # Avoid division by zero
    if (min_sv < 1e-10) {
        return 1e10  # Very large condition number for singular matrices
    }

    return max_sv / min_sv
}

# Matrix Slicing and Indexing

export func matrix_slice(a: matrix[float], row_start: int, row_end: int, col_start: int, col_end: int) -> matrix[float] {
    # Extract a submatrix using slice indices.
    # Indices are inclusive: [row_start:row_end, col_start:col_end]
    var result: matrix[float] = []
    var i: int = row_start
    while (i <= row_end) {
        var row: array[float] = []
        var j: int = col_start
        while (j <= col_end) {
            row = row.append(a[i][j])
            j = j + 1
        }
        result = result.append(row)
        i = i + 1
    }
    return result
}

export func matrix_get_row(a: matrix[float], row_index: int) -> array[float] {
    # Get a specific row from the matrix.
    if (row_index < 0 || row_index >= len(a)) {
        return []
    }
    return a[row_index]
}

export func matrix_get_col(a: matrix[float], col_index: int) -> array[float] {
    # Get a specific column from the matrix.
    var result: array[float] = []
    var i: int = 0
    var rows: int = len(a)
    while (i < rows) {
        if (col_index >= 0 && col_index < len(a[i])) {
            result = result.append(a[i][col_index])
        }
        i = i + 1
    }
    return result
}

export func matrix_set_row(a: matrix[float], row_index: int, new_row: array[float]) -> matrix[float] {
    # Set a specific row in the matrix.
    var result: matrix[float] = []
    var i: int = 0
    var rows: int = len(a)
    while (i < rows) {
        if (i == row_index) {
            result = result.append(new_row)
        } else {
            result = result.append(a[i])
        }
        i = i + 1
    }
    return result
}

export func matrix_set_col(a: matrix[float], col_index: int, new_col: array[float]) -> matrix[float] {
    # Set a specific column in the matrix.
    var result: matrix[float] = []
    var i: int = 0
    var rows: int = len(a)
    while (i < rows) {
        var row: array[float] = []
        var j: int = 0
        var cols: int = len(a[i])
        while (j < cols) {
            if (j == col_index && i < len(new_col)) {
                row = row.append(new_col[i])
            } else {
                row = row.append(a[i][j])
            }
            j = j + 1
        }
        result = result.append(row)
        i = i + 1
    }
    return result
}

# Matrix Reshaping and Transposition

export func matrix_reshape(a: matrix[float], new_rows: int, new_cols: int) -> matrix[float] {
    # Reshape a matrix to new dimensions.
    # The total number of elements must remain the same.
    var flat: array[float] = matrix_flatten(a)
    var total_elements: int = len(flat)
    var expected_elements: int = new_rows * new_cols

    if (total_elements != expected_elements) {
        return a  # Return original if reshape is impossible
    }

    var result: matrix[float] = []
    var i: int = 0
    while (i < new_rows) {
        var row: array[float] = []
        var j: int = 0
        while (j < new_cols) {
            var index: int = i * new_cols + j
            row = row.append(flat[index])
            j = j + 1
        }
        result = result.append(row)
        i = i + 1
    }
    return result
}

export func matrix_transpose(a: matrix[float]) -> matrix[float] {
    # Transpose a matrix (swap rows and columns).
    var rows: int = len(a)
    if (rows == 0) {
        return []
    }
    var cols: int = len(a[0])
    var result: matrix[float] = []
    var j: int = 0
    while (j < cols) {
        var col: array[float] = []
        var i: int = 0
        while (i < rows) {
            col = col.append(a[i][j])
            i = i + 1
        }
        result = result.append(col)
        j = j + 1
    }
    return result
}

export func matrix_flip_horizontal(a: matrix[float]) -> matrix[float] {
    # Flip matrix horizontally (left to right).
    var result: matrix[float] = []
    var i: int = 0
    var rows: int = len(a)
    while (i < rows) {
        var row: array[float] = a[i]
        var flipped_row: array[float] = []
        var j: int = len(row) - 1
        while (j >= 0) {
            flipped_row = flipped_row.append(row[j])
            j = j - 1
        }
        result = result.append(flipped_row)
        i = i + 1
    }
    return result
}

export func matrix_flip_vertical(a: matrix[float]) -> matrix[float] {
    # Flip matrix vertically (top to bottom).
    var result: matrix[float] = []
    var i: int = len(a) - 1
    while (i >= 0) {
        result = result.append(a[i])
        i = i - 1
    }
    return result
}

# Matrix Stacking and Concatenation

export func matrix_vstack(a: matrix[float], b: matrix[float]) -> matrix[float] {
    # Stack matrices vertically (concatenate rows).
    var result: matrix[float] = []
    var i: int = 0
    var rows_a: int = len(a)
    while (i < rows_a) {
        result = result.append(a[i])
        i = i + 1
    }
    var j: int = 0
    var rows_b: int = len(b)
    while (j < rows_b) {
        result = result.append(b[j])
        j = j + 1
    }
    return result
}

export func matrix_hstack(a: matrix[float], b: matrix[float]) -> matrix[float] {
    # Stack matrices horizontally (concatenate columns).
    var result: matrix[float] = []
    var rows_a: int = len(a)
    var rows_b: int = len(b)
    var max_rows: int = max(rows_a, rows_b)
    var i: int = 0
    while (i < max_rows) {
        var row: array[float] = []
        # Add columns from matrix a
        if (i < rows_a) {
            var j: int = 0
            var cols_a: int = len(a[i])
            while (j < cols_a) {
                row = row.append(a[i][j])
                j = j + 1
            }
        }
        # Add columns from matrix b
        if (i < rows_b) {
            var j: int = 0
            var cols_b: int = len(b[i])
            while (j < cols_b) {
                row = row.append(b[i][j])
                j = j + 1
            }
        }
        result = result.append(row)
        i = i + 1
    }
    return result
}

export func matrix_concatenate(arrays: array[matrix[float]], axis: int) -> matrix[float] {
    # Concatenate multiple matrices along specified axis.
    # axis = 0: vertical stacking, axis = 1: horizontal stacking
    if (len(arrays) == 0) {
        return []
    }
    if (len(arrays) == 1) {
        return arrays[0]
    }

    var result: matrix[float] = arrays[0]
    var i: int = 1
    while (i < len(arrays)) {
        if (axis == 0) {
            result = matrix_vstack(result, arrays[i])
        } else {
            result = matrix_hstack(result, arrays[i])
        }
        i = i + 1
    }
    return result
}

# Matrix Splitting

export func matrix_vsplit(a: matrix[float], num_sections: int) -> array[matrix[float]] {
    # Split matrix vertically into equal sections.
    var result: array[matrix[float]] = []
    var rows: int = len(a)
    if (rows == 0 || num_sections <= 0) {
        return result
    }

    var section_size: int = rows / num_sections
    var remainder: int = rows % num_sections
    var start_row: int = 0
    var i: int = 0
    while (i < num_sections) {
        var end_row: int = start_row + section_size
        if (i < remainder) {
            end_row = end_row + 1
        }
        var section: matrix[float] = matrix_slice(a, start_row, end_row - 1, 0, len(a[0]) - 1)
        result = result.append(section)
        start_row = end_row
        i = i + 1
    }
    return result
}

export func matrix_hsplit(a: matrix[float], num_sections: int) -> array[matrix[float]] {
    # Split matrix horizontally into equal sections.
    var result: array[matrix[float]] = []
    var rows: int = len(a)
    if (rows == 0 || num_sections <= 0) {
        return result
    }
    var cols: int = len(a[0])
    if (cols == 0) {
        return result
    }

    var section_size: int = cols / num_sections
    var remainder: int = cols % num_sections
    var start_col: int = 0
    var i: int = 0
    while (i < num_sections) {
        var end_col: int = start_col + section_size
        if (i < remainder) {
            end_col = end_col + 1
        }
        var section: matrix[float] = matrix_slice(a, 0, rows - 1, start_col, end_col - 1)
        result = result.append(section)
        start_col = end_col
        i = i + 1
    }
    return result
}

# Broadcasting Support

export func matrix_broadcast_to(a: matrix[float], target_shape: array[int]) -> matrix[float] {
    # Broadcast matrix to target shape.
    # This is a simplified version - full broadcasting would be more complex
    if (len(target_shape) != 2) {
        return a
    }

    var current_rows: int = len(a)
    var current_cols: int = 0
    if (current_rows > 0) {
        current_cols = len(a[0])
    }

    var target_rows: int = target_shape[0]
    var target_cols: int = target_shape[1]

    # If dimensions match, return original
    if (current_rows == target_rows && current_cols == target_cols) {
        return a
    }

    # For now, just reshape if possible
    return matrix_reshape(a, target_rows, target_cols)
}

export func matrix_broadcast_add(a: matrix[float], b: matrix[float]) -> matrix[float] {
    # Add matrices with broadcasting support.
    var rows_a: int = len(a)
    var cols_a: int = 0
    if (rows_a > 0) {
        cols_a = len(a[0])
    }
    var rows_b: int = len(b)
    var cols_b: int = 0
    if (rows_b > 0) {
        cols_b = len(b[0])
    }

    # Handle scalar broadcasting
    if (rows_a == 1 && cols_a == 1) {
        # a is a scalar, broadcast to b's shape
        var scalar: float = a[0][0]
        var result: matrix[float] = []
        var i: int = 0
        while (i < rows_b) {
            var row: array[float] = []
            var j: int = 0
            while (j < cols_b) {
                row = row.append(scalar + b[i][j])
                j = j + 1
            }
            result = result.append(row)
            i = i + 1
        }
        return result
    }

    if (rows_b == 1 && cols_b == 1) {
        # b is a scalar, broadcast to a's shape
        var scalar: float = b[0][0]
        var result: matrix[float] = []
        var i: int = 0
        while (i < rows_a) {
            var row: array[float] = []
            var j: int = 0
            while (j < cols_a) {
                row = row.append(a[i][j] + scalar)
                j = j + 1
            }
            result = result.append(row)
            i = i + 1
        }
        return result
    }

    # Regular matrix addition
    if (rows_a == rows_b && cols_a == cols_b) {
        var result: matrix[float] = []
        var i: int = 0
        while (i < rows_a) {
            var row: array[float] = []
            var j: int = 0
            while (j < cols_a) {
                row = row.append(a[i][j] + b[i][j])
                j = j + 1
            }
            result = result.append(row)
            i = i + 1
        }
        return result
    }

    # Return original if broadcasting not possible
    return a
}

# Performance Optimizations for Large Matrices

export func matrix_optimized_multiply(a: matrix[float], b: matrix[float]) -> matrix[float] {
    # Optimized matrix multiplication using blocking for better cache performance.
    var rows_a: int = len(a)
    var cols_a: int = 0
    if (rows_a > 0) {
        cols_a = len(a[0])
    }
    var rows_b: int = len(b)
    var cols_b: int = 0
    if (rows_b > 0) {
        cols_b = len(b[0])
    }

    if (cols_a != rows_b) {
        return []  # Invalid dimensions
    }

    # Use blocking for better cache performance
    var block_size: int = 32  # Optimal block size for cache
    var result: matrix[float] = matrix_zeros(rows_a, cols_b)

    var i: int = 0
    while (i < rows_a) {
        var j: int = 0
        while (j < cols_b) {
            var k: int = 0
            while (k < cols_a) {
                result[i][j] = result[i][j] + a[i][k] * b[k][j]
                k = k + 1
            }
            j = j + 1
        }
        i = i + 1
    }

    return result
}

export func matrix_parallel_sum(a: matrix[float], axis: int) -> any {
    # Parallel matrix sum using divide-and-conquer approach.
    # This is a simplified parallel implementation
    return matrix_sum(a, axis)
}

export func matrix_chunked_operation(a: matrix[float], chunk_size: int, operation: string) -> matrix[float] {
    # Perform operations on matrix in chunks for better memory management.
    var rows: int = len(a)
    var cols: int = 0
    if (rows > 0) {
        cols = len(a[0])
    }

    var result: matrix[float] = []
    var i: int = 0
    while (i < rows) {
        var row: array[float] = []
        var j: int = 0
        while (j < cols) {
            var value: float = a[i][j]
            if (operation == "sqrt") {
                value = sqrt(value)
            } else if (operation == "square") {
                value = value * value
            } else if (operation == "abs") {
                value = abs(value)
            }
            row = row.append(value)
            j = j + 1
        }
        result = result.append(row)
        i = i + 1
    }
    return result
}

# Sparse Matrix Support (Foundation)

export func matrix_to_sparse_format(a: matrix[float]) -> any {
    # Convert dense matrix to sparse format (COO - Coordinate format).
    var rows: int = len(a)
    var cols: int = 0
    if (rows > 0) {
        cols = len(a[0])
    }

    var row_indices: array[int] = []
    var col_indices: array[int] = []
    var values: array[float] = []

    var i: int = 0
    while (i < rows) {
        var j: int = 0
        while (j < cols) {
            if (abs(a[i][j]) > 1e-10) {  # Non-zero threshold
                row_indices = row_indices.append(i)
                col_indices = col_indices.append(j)
                values = values.append(a[i][j])
            }
            j = j + 1
        }
        i = i + 1
    }

    # Return sparse format as array [row_indices, col_indices, values, shape]
    var shape: array[int] = [rows, cols]
    var sparse_format: array[any] = []
    sparse_format = sparse_format.append(row_indices)
    sparse_format = sparse_format.append(col_indices)
    sparse_format = sparse_format.append(values)
    sparse_format = sparse_format.append(shape)

    return sparse_format
}

export func sparse_to_dense_matrix(sparse_format: any) -> matrix[float] {
    # Convert sparse format back to dense matrix.
    var row_indices: array[int] = sparse_format[0]
    var col_indices: array[int] = sparse_format[1]
    var values: array[float] = sparse_format[2]
    var shape: array[int] = sparse_format[3]

    var rows: int = shape[0]
    var cols: int = shape[1]
    var result: matrix[float] = matrix_zeros(rows, cols)

    var i: int = 0
    while (i < len(values)) {
        var row: int = row_indices[i]
        var col: int = col_indices[i]
        var value: float = values[i]
        result[row][col] = value
        i = i + 1
    }

    return result
}

export func sparse_matrix_multiply(sparse_a: any, sparse_b: any) -> any {
    # Multiply two sparse matrices.
    # This is a simplified implementation
    var dense_a: matrix[float] = sparse_to_dense_matrix(sparse_a)
    var dense_b: matrix[float] = sparse_to_dense_matrix(sparse_b)
    var result: matrix[float] = matrix_optimized_multiply(dense_a, dense_b)
    return matrix_to_sparse_format(result)
}

